# The packages the backend imports directly. Edit THIS file, then regenerate
# the fully pinned requirements.txt (which also lists every sub-dependency):
#
#   python3.12 -m venv /tmp/reqs && /tmp/reqs/bin/pip install -r requirements.in
#   /tmp/reqs/bin/pip freeze > requirements.txt   # then re-add the header comment
#
# Render installs requirements.txt, so deploys get exactly these versions.

