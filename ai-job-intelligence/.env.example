# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required in production -------------------------------------------------

# JWT signing key. Anyone holding this can mint a valid login token for any
# user, so treat it like a password and use a different one per environment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, a random key is generated and cached in
# src/.secret_key (gitignored). Required when APP_ENV=production.
SECRET_KEY=

# "development" (default) or "production". In production the app refuses to
# start without a real SECRET_KEY rather than falling back to a generated one.
APP_ENV=development

# --- Services ---------------------------------------------------------------

GOOGLE_API_KEY=your_google_api_key_here
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_job_intelligence
UPLOAD_DIR=./uploads

# Browser origins allowed to call this API (comma-separated). Must include the
# frontend's exact scheme, host and port, or the browser blocks every request
# and the UI shows only "Failed to fetch".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
